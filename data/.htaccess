# BDMovieHub - Data directory protection
# Deny direct web access to JSON files in /data/ (they're only used by PHP)

# Apache 2.4+ (preferred)
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2 fallback
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>

# Belt-and-suspenders: deny .json/.log/.txt by file extension
<FilesMatch "\.(json|log|txt)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
